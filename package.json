{
  "name": "renan.dev",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    ">0.5%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/*",
    "dev": "bun run --bun vite dev",
    "build": "npx vite build --mode prod",
    "start": "bun .vercel/output/functions/__server.func/index.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@giscus/react": "^3.1.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "^0.8.6",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-router-devtools": "^1.167.3",
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "nitro": "^3.0.261103-rc",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
