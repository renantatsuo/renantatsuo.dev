{
  "name": "renan.dev",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    ">0.5%",
    "not ie 11",
    "not dead",
    "not op_mini all"
  ],
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/*",
    "dev": "bun run --bun vite dev",
    "build": "npx vite build --mode prod",
    "start": "bun .vercel/output/functions/__server.func/index.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@giscus/react": "^3.1.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-react": "^3.1.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/vite": "^4.2.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/bun": "^1.3.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.28",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "nitro": "^3.0.260415-beta",
    "tailwindcss": "^4.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-mock-extended": "^2.0.2"
  }
}
